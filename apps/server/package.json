{
  "name": "@percival/server",
  "version": "0.0.1",
  "private": true,
  "description": "Percival API: Fastify, Prisma, PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "create-admin": "tsx --env-file=../../.env src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "@percival/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
