# Copy this file to `.env` (never commit `.env`) and adjust the values.
# `.env` is read by docker compose and by the server when run from the host (pnpm dev).

# --- PostgreSQL (container "db") ---
POSTGRES_USER=percival
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=percival
# Host port for PostgreSQL, published on 127.0.0.1 only (Prisma CLI, Studio, psql).
POSTGRES_PORT=5432

# --- API ---
# Host port for the API. Put `tailscale serve` in front of it for HTTPS.
API_PORT=3000
# Only used when the API runs on the host (pnpm dev, prisma). Inside docker compose,
# the URL is built from the POSTGRES_* variables above.
DATABASE_URL=postgresql://percival:change-me-postgres@localhost:5432/percival

# Secret that signs JWTs. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-with-a-long-random-secret-of-32-chars-minimum
# Token lifetime (e.g. 12h, 7d).
JWT_EXPIRES_IN=7d

# --- First administrator (optional) ---
# If both are set and no admin exists yet, the server creates the account at startup.
# Remove them from .env afterwards. Otherwise use `pnpm --filter @percival/server create-admin`.
ADMIN_USERNAME=
ADMIN_PASSWORD=
